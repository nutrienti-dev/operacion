# Copie este archivo como .streamlit/secrets.toml (local) o pegue su contenido
# en Streamlit Cloud → App → Settings → Secrets. NUNCA lo suba a GitHub.

# Mismas credenciales OAuth que la app de pedidos (cuenta contacto@nutrienti.co).
[gcp_oauth]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
refresh_token = "xxxx"
token_uri = "https://oauth2.googleapis.com/token"

[app]
# Opcional. Si no se pone, la app busca/crea "Nutrienti - Track Operacion"
# en la carpeta "Integracion AI". Recomendado: despues del primer uso, copiar
# aqui el ID de la hoja creada para que no dependa del nombre.
sheet_id = "1KeIRNsTJY_7q07jnEo8VijIiYsti7JA7c84Ue9GngBM"   # hoja "registro operacion"
# pin = "1234"          # opcional: pide un PIN para entrar
